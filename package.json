{
	"name": "golem",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc -p bot/tsconfig.json --noEmit",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"bot": "node --env-file-if-exists=.env bot/src/index.ts",
		"bot:deploy": "node --env-file-if-exists=.env bot/src/deploy-commands.ts",
		"bot:deploy:global": "node --env-file-if-exists=.env bot/src/deploy-commands.ts --global",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "node --env-file-if-exists=.env bot/src/migrate.ts",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write ."
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@fontsource-variable/outfit": "^5.3.0",
		"@internationalized/date": "^3.12.4",
		"@sveltejs/adapter-node": "^6.0.1",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tabler/icons-svelte": "^3.50.0",
		"@tailwindcss/vite": "^4.3.0",
		"@types/better-sqlite3": "^9.6.0",
		"@types/node": "^26",
		"bits-ui": "^2.20.2",
		"cn": "^0.5.1",
		"drizzle-kit": "^0.31.11",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"layerchart": "^2.9.2",
		"mode-watcher": "^1.1.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"shadcn-svelte": "^1.7.2",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.0",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.3.0"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*",
		"#bot/*": "./bot/src/*"
	},
	"dependencies": {
		"@fontsource/outfit": "^5.3.0",
		"@fontsource/playfair-display": "^5.3.0",
		"@resvg/resvg-js": "^2.6.2",
		"better-sqlite3": "^13.0.3",
		"discord.js": "^14.28.0",
		"drizzle-orm": "^0.45.4",
		"fast-xml-parser": "^5.11.2",
		"gifenc": "^1.0.3",
		"satori": "^0.63.2",
		"yaml": "^2.9.1"
	}
}
