DISCORD_BOT_TOKEN=
# Developer portal → OAuth2 → Client Secret. Needed for dashboard sign-in.
DISCORD_CLIENT_SECRET=
# Optional. Overrides applicationId in config.yaml so a local run can use a separate development application.
DISCORD_CLIENT_ID=
# Optional. A test server id. `pnpm bot:deploy` registers commands there instantly instead of globally.
DISCORD_GUILD_ID=
# Optional. Where the SQLite database lives. Defaults to data/golem.db.
DATABASE_PATH=
